# Environment example

# Frontend (safe to expose in client config)
# NOTE: VITE_* variables are embedded into the client bundle by Vite — do NOT put secrets here.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=public-anon-key

# Server-only (never put these in frontend)
# These must remain secret (store in server/CI secrets)
SUPABASE_SERVICE_ROLE_KEY=service-role-key

# Providers
# Supported values: "elevenlabs" or "google"
TTS_PROVIDER=elevenlabs

# ElevenLabs
ELEVENLABS_API_KEY=elevenlabs_api_key_here

# Google Cloud TTS
# Either provide the path to a service account JSON file on the server,
# or put the JSON contents as a single-line value (base64-encoded if preferred).
# Example (path): /etc/secrets/google-service-account.json
# Example (base64): eyJ0eXAiOiJKV1QiLCJhbGciOiJSUzI1...
GOOGLE_CLOUD_TTS_KEY=/path/to/google-service-account.json
# OR
# GOOGLE_CLOUD_TTS_KEY_BASE64=base64-encoded-json

# Optional analytics / error reporting
SENTRY_DSN=

# Notes:
# - Do NOT commit real keys to git. Use environment/secret management (CI, hosting provider).
# - Update this example to document any additional provider-specific options your app requires.
