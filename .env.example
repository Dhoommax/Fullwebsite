.env.example

# Public (frontend) - safe to expose to the client runtime
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=public-anon-key
VITE_TTS_PROVIDER=none # provider key: none|google|elevenlabs
VITE_AI_PROVIDER=none

# Server-only (do NOT expose in the frontend)
# Put these in Vercel's Environment Variables (Server) or your deployment secrets
SUPABASE_SERVICE_ROLE_KEY=super-secret-service-role-key
TTS_API_KEY=your-tts-api-key
AI_API_KEY=your-ai-api-key

# Optional
NEXT_PUBLIC_FEATURE_FLAG=0
